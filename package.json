{
  "name": "anzai-midterm-report",
  "version": "1.0.0",
  "private": true,
  "description": "你還好嗎？安在 AnZai — 不用鏡頭的浴室安全守護系統（健康物聯網趨勢與創新・期中報告）",
  "scripts": {
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "fonts": "python3 tools/build-fonts.py",
    "check": "node tools/inspect.mjs --quick",
    "inspect": "node tools/inspect.mjs",
    "export:pdf": "node tools/export-pdf.mjs",
    "export:report": "node tools/export-report.mjs",
    "export:video": "node tools/render-video.mjs",
    "export": "npm run export:pdf && npm run export:report && npm run export:video"
  },
  "devDependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/lxgw-wenkai-tc": "^0.4.2",
    "@expo-google-fonts/noto-sans-tc": "^0.4.3",
    "@expo-google-fonts/noto-serif-tc": "^0.4.4",
    "gsap": "3.15.0",
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.1"
  }
}
